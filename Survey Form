<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Survey Form</title>
  </head>

  <body>
    <form id="survey-form" method="POST" action="https://hotel-feedback.freecodecamp.org">
      <h1 id="title">Survey Form 2026</h1>
      <p id="description">5 mins survey to complete in order to be entitled to $5 NTUC voucher.</p>
      <fieldset>
        <legend>Personal Particulars</legend>

        <label for="name" id="name-label">Name:</label>
        <input
          id="name"
          name="name" 
          type="text" placeholder="Judy Tan" required
        />

        <label for="email" id="email-label"><br>Email:</label>
        <input
          id="email"
          name="email" 
          type="email"
          placeholder="example@email.com" 
          required
        />

        <label for="number" id="number-label"><br>Age(optional):</label>
        <input
          id="number"
          name="number" 
          type="number"
          placeholder="1-100"
          min="1"
          max="100" 
          required
        />
        
      </fieldset>

      <fieldset>
        <legend>Which option best describes your current role?</legend>

        <label for="dropdown"></label>
        <select id="dropdown">
          <option selected hidden disabled>Select current role</option>
          <option>Student</option>
          <option>Unemployed</option>
          <option>Employed</option>
        </select>
        
      </fieldset>

      <fieldset>
        <legend>Would you recommend freeCodeCamp to a friend?</legend>
        
        <input type="radio" id="r-yes" name="choice" value="definitely">
        <label>Definitely</label>

        <input type="radio" id="r-maybe" name="choice" value="maybe">
        <label for="r-maybe">Maybe</label>
        
        <input type="radio" id="r-unsure" name="choice" value="unsure">
        <label for="r-unsure">Unsure</label>


      </fieldset>

      <fieldset>
        <legend>What is your favorite feature of freeCodeCamp?</legend>

        <label for="dropdown2"></label>
        <select id="dropdown2">
          <option selected hidden disabled>Select an option</option>
          <option>Free Tutorials</option>
          <option>Challenges</option>
          <option>Step-by-step guidance</option>
        </select>

      </fieldset>

      <fieldset>
        <legend>What would you like to see improved? (Check all that apply)</legend>
        
        <input 
          type="checkbox" id="more-detail" name="more-detail"
          value="chosen"
        />
        <label for="more-detail">More details</label>
        
        <input 
          type="checkbox" id="p-language" name="p-language"
          value="chosen"
        />
        <label for="p-language">Programming Language</label>

        <input 
          type="checkbox"
          id="descriptive" name="descriptive"
          value="chosen"
        />
        <label for="descriptive">Descriptive information</label>
        
        <input
          type="checkbox" 
          id="live-agent" name="live-agent"
          value="chosen"
        />
        <label for="live-agent">Live agents</label>
        
        <input
        type="checkbox"
        id="ai"
        name="ai"
        value="chosen"
        />
        <label for="ai">AI Assistance</label>
        
        <input
          type="checkbox"
          id="github"
          name="github"
          value="chosen"
        />
        <label for="github">Autosync to Github</label>
        
        <input
          type="checkbox"
          id="video"
          name="video"
          value="chosen"
        />
        <label for="video">Online Video tutorial</label>
        
        <input
          type="checkbox"
          id="glossary"
          name="glossary"
          value="chosen"
        />
        <label for="glossary">Glossary</label>

      </fieldset>

      <br>
      <label for="comments">Any comments or suggestions</label>
      <textarea id="comments" name="comments" cols="30" rows="10">
      </textarea>

      <button id="submit">
        Submit
      </button>

    </form>
  </body>
</html>
